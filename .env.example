# ============================================================
# Cantina Manager - Variables de entorno
# ============================================================
# Copia este archivo a .env y completa los valores
# cp .env.example .env

# URL de conexion a la base de datos PostgreSQL (Supabase)
# Obtenerla desde: Supabase Dashboard > Project Settings > Database > Connection string
# Pooler (Transaction mode, puerto 6543) — usar en runtime/serverless:
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Conexion directa (puerto 5432) — requerida por Prisma para migraciones:
DIRECT_URL="postgresql://postgres.[ref]:[password]@db.[ref].supabase.co:5432/postgres"

# Para desarrollo local con SQLite (alternativa simple):
# DATABASE_URL="file:./db/custom.db"
# (en ese caso, cambiar provider en prisma/schema.prisma a "sqlite")
